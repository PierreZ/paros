---
// The playground (#518, #813 (live playground)): one live paros universe in
// the browser on moonpool-sim. The app is website/sandbox/ (main.js,
// stage.js, worker.js, style.css), staged at /playground/app/ with its wasm
// by scripts/build-wasm.sh.
import Base from "../../layouts/Base.astro";
import { url } from "../../nav";
---
<Base title="Playground" section="playground/" wide description="A live paros universe in your browser: cells of machines on a simulated network, disk and clock. Click to operate it, break it, and watch it recover.">
  <link slot="head" rel="stylesheet" href={url("playground/app/style.css")} />
  <div class="intro">
    <div class="kicker label">Playground</div>
    <h1>paros, live</h1>
    <p class="lede">Eight machines run <code>parosd</code>, the shipped code. Every button runs the same call as
      <code>parosctl</code> and prints its line. <a href={url("docs/playground/")}>How the playground works</a></p>
    <div class="callout" data-tag="NOTE">The network, the disks and the clock are simulated (moonpool). Nothing
      here measures paros: times are simulated time.</div>
  </div>
  <div class="app">
    <div class="strip">
      <div><span class="k">Seed</span><span class="v" id="seed">1</span></div>
      <div><span class="k">Simulated time</span><span class="v" id="time">0.0 s</span></div>
      <div><span class="k">Status</span><span class="v" id="status"></span></div>
      <div><span class="k">Cells</span><span class="v" id="cells-count">0</span></div>
      <div><span class="k">Machines up</span><span class="v" id="machines-up">0</span></div>
      <div><span class="k">Journals</span><span class="v" id="journals-count">0</span></div>
    </div>

    <section class="panel ops">
      <div class="panel-head label"><span class="num">00</span><span class="title">Operator</span><span class="meta">each click runs one parosctl call</span></div>
      <div class="panel-body">
        <div class="groups">
          <div class="group">
            <div class="label">Bootstrap</div>
            <button class="btn primary" data-act="init" title="Form cell-1 over machines 0 to 2 and the universe on it">Init cell-1</button>
            <button class="btn" data-act="add-machine" title="Admit the next idle machine into cell-1">Add a machine</button>
            <button class="btn" data-act="add-cell" title="Form an idle cell over the last three idle machines, then join it to the universe">Add cell-2</button>
          </div>
          <div class="group">
            <div class="label">Resources</div>
            <button class="btn" data-act="tenant" title="Create a tenant in the cell picked below">Create a tenant</button>
            <button class="btn" data-act="journal" title="Create one journal in the newest tenant">Create a journal</button>
            <button class="btn" data-act="journals" title="Create three journals in the newest tenant">Add 3 journals</button>
            <button class="btn" data-act="configure" title="Record a new durability and replica count for the journal picked below">Configure</button>
          </div>
          <div class="group">
            <div class="label">Workloads</div>
            <button class="btn" data-act="traffic" title="Write ten records to every journal at the same time">Generate traffic</button>
            <button class="btn" data-act="stream" id="stream-btn" title="A writer appends to the journal picked below five times a second">Start a writer</button>
            <button class="btn" data-act="write" title="Write five records to the journal picked below">Write</button>
            <button class="btn" data-act="read" title="Read the last five records of the journal picked below">Read the tail</button>
            <button class="btn" data-act="set-leader" title="A new writer takes the journal; the old writer's next write is refused">Set a new leader</button>
            <button class="btn" data-act="resolve" title="Ask where the universe sends the tenant's clients">Resolve</button>
          </div>
          <div class="group">
            <div class="label">Machines</div>
            <button class="btn" data-act="maintenance" title="The cell does not re-place the machine's slots for 30 s">Maintenance</button>
            <button class="btn" data-act="drain" title="The cell moves every slot off an added machine">Drain</button>
            <button class="btn" data-act="remove" title="Retire a drained machine">Remove</button>
          </div>
          <div class="group">
            <div class="label">Faults</div>
            <button class="btn" data-act="kill" title="Crash the machine that leads the most journals, or the one picked">Kill a machine</button>
            <button class="btn" data-act="restart" title="Start a crashed machine again on its disk">Restart</button>
            <button class="btn" data-act="isolate" title="Drop every message to or from a machine">Cut off</button>
            <button class="btn" data-act="heal" title="Join a cut machine to the network again">Heal</button>
          </div>
        </div>
        <div class="picks">
          <label>Machine <select id="machine-pick"><option value="auto">auto</option></select></label>
          <label>Journal <select id="journal-pick"></select></label>
          <label>Cell <select id="cell-pick"><option>cell-1</option><option disabled>cell-2</option></select></label>
          <label>Durability <select id="mode">
            <option value="machines=0">survive 0 machines (1 acceptor)</option>
            <option value="machines=1" selected>survive 1 machine (3 acceptors)</option>
            <option value="machines=2">survive 2 machines (5 acceptors)</option>
            <option value="machines=0,partitions=2">2 partitions of 1 acceptor</option>
            <option value="machines=1,partitions=2">2 partitions of 3 acceptors</option>
          </select></label>
          <label>Writers <select id="writers"><option value="single">single</option><option value="multi">multi</option></select></label>
          <label>Layout <select id="layout"><option value="colocated" selected>colocated</option><option value="compartmentalized">compartmentalized</option></select></label>
        </div>
      </div>
    </section>

    <div class="stage-wrap">
      <section class="panel">
        <div class="panel-head label"><span class="num">01</span><span class="title">Cells</span><span class="meta" id="legend"></span></div>
        <div class="stage" id="stage">
          <canvas id="wires"></canvas>
          <div class="cells" id="cells"></div>
          <div class="outside"><div class="client" id="client">client</div></div>
        </div>
      </section>
      <section class="panel">
        <div class="panel-head label"><span class="num">02</span><span class="title">Journal</span><span class="meta" id="followed"></span></div>
        <div class="panel-body rail" id="rail"></div>
      </section>
    </div>

    <div class="lower">
      <section class="panel">
        <div class="panel-head label"><span class="num">03</span><span class="title">Roles</span><span class="meta">from the admin API, every second</span></div>
        <div class="panel-body table-wrap" id="roles"></div>
      </section>
      <section class="panel">
        <div class="panel-head label"><span class="num">04</span><span class="title">Operator log</span><span class="meta">parosctl lines and what they did</span></div>
        <div class="panel-body log" id="log"></div>
      </section>
    </div>

    <div class="dock">
      <div class="controls">
        <button class="btn" id="play">❚❚ Pause</button>
        <label class="inline">Speed <select id="speed"></select></label>
        <label class="inline"><input id="show-beats" type="checkbox" /> heartbeats</label>
        <label class="inline">Seed <input id="seed-input" type="number" min="1" /></label>
        <button class="btn" id="reset" title="Start a fresh universe with this seed">Reset</button>
      </div>
      <canvas id="timeline" class="timeline" title="The last 30 simulated seconds: messages by tenant, and the operator's steps"></canvas>
    </div>
  </div>
  <script is:inline type="module" src={url("playground/app/main.js")}></script>
</Base>
