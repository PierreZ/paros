---
// The playground (#518, #810 (website redo 1/4)): a paros universe in the
// browser on moonpool-sim. Same layout as every page; the app is
// website/sandbox/ (main.js, stage.js, worker.js, style.css), staged at
// /playground/app/ with its wasm by scripts/build-wasm.sh.
import Base from "../../layouts/Base.astro";
import { url } from "../../nav";
---
<Base title="Playground" section="playground/" wide description="Run a paros universe in your browser: a cell of machines on a simulated network, disk and clock. Drive it, break it, watch it recover.">
  <link slot="head" rel="stylesheet" href={url("playground/app/style.css")} />
  <div class="intro">
    <div class="kicker label">Playground</div>
    <h1>paros playground</h1>
    <p class="lede">A tool to understand Paxos and paros: run a paros universe in your browser, drive it, break it
      and watch it recover. Every machine runs the same code as <code>parosd</code>, and the operator uses
      the same calls as <code>parosctl</code>. <a href={url("docs/playground/")}>How the playground works</a></p>
    <div class="callout" data-tag="NOTE">The network, the disks and the clock are simulated. Times are simulated
      milliseconds, not production numbers. A run depends only on its seed, its configuration and its
      action log, so the link to this page replays it exactly.</div>
  </div>
  <div class="app">
    <section class="stage-section">
      <div class="acts" id="acts"></div>
      <div class="stage-wrap">
        <div class="stage" id="stage">
          <canvas id="wires"></canvas>
          <div class="cell" id="cell"></div>
          <div class="outside" id="outside">
            <div class="client" id="client" hidden>client</div>
          </div>
        </div>
        <aside class="rail" id="rail"></aside>
      </div>
      <p class="caption" id="caption"></p>
      <div class="controls">
        <button id="play" title="Play or pause (space)">▶</button>
        <button id="prev-msg" title="Previous message ([)">◀ msg</button>
        <button id="next-msg" title="Next message (])">msg ▶</button>
        <button id="prev-step" title="Previous step of the log (,)">◀ step</button>
        <button id="next-step" title="Next step of the log (.)">step ▶</button>
        <label class="inline">Speed <select id="speed">
          <option value="0.02">0.02×</option>
          <option value="0.05" selected>0.05×</option>
          <option value="0.2">0.2×</option>
          <option value="1">1×</option>
        </select></label>
        <label class="inline"><input id="show-beats" type="checkbox" checked /> heartbeats</label>
        <span class="time" id="time"></span>
        <span class="legend" id="legend"></span>
      </div>
      <canvas id="timeline" class="timeline" title="Drag to move in time"></canvas>
    </section>
    <div class="lower">
      <div>
        <section>
          <h2>Universe</h2>
          <div class="row">
            <label>Seed <input id="seed" type="number" min="0" /></label>
            <label>Machines <input id="machines" type="number" min="1" max="7" /></label>
            <label>Run length (s) <input id="run" type="number" min="1" max="300" /></label>
          </div>
          <p class="muted">One cell, <code>cell-1</code>, over three zones: machine <i>i</i> is in
            zone <i>i</i> mod 3.</p>
          <div class="row">
            <label>Example <select id="preset"></select></label>
            <button id="load-preset">Load</button>
          </div>
        </section>
        <section>
          <h2>Action log</h2>
          <ol class="actions" id="actions" start="0"></ol>
          <div class="row">
            <label>At (ms) <input id="at" type="number" min="1" step="100" /></label>
            <label>Action <select id="op">
              <option value="create_tenant">create a tenant</option>
              <option value="create_journal">create a journal</option>
              <option value="write">write N records</option>
              <option value="read">read N records</option>
              <option value="crash">crash a machine</option>
              <option value="restart">restart a machine</option>
              <option value="isolate">cut a machine from the network</option>
              <option value="heal">join a machine to the network again</option>
            </select></label>
            <label id="machine-pick-field">Machine <select id="machine-pick"></select></label>
            <label id="tenant-name-field">Tenant <input id="tenant-name" value="acme" size="10" /></label>
            <label id="tenant-pick-field">Tenant <select id="tenant-pick"></select></label>
            <label id="journal-name-field">Journal <input id="journal-name" value="orders" size="10" /></label>
            <label id="mode-field">Mode <select id="mode">
              <option value="machines=0">survive 0 machines · 1 partition (1 acceptor)</option>
              <option value="machines=1" selected>survive 1 machine · 1 partition (3 acceptors)</option>
              <option value="machines=2">survive 2 machines · 1 partition (5 acceptors)</option>
              <option value="machines=3">survive 3 machines · 1 partition (7 acceptors)</option>
              <option value="machines=0,partitions=2">survive 0 machines · 2 partitions (2 acceptors)</option>
              <option value="machines=0,partitions=4">survive 0 machines · 4 partitions (4 acceptors)</option>
              <option value="machines=1,partitions=2">survive 1 machine · 2 partitions (6 acceptors)</option>
            </select></label>
            <label id="journal-pick-field">Journal <select id="journal-pick"></select></label>
            <label id="count-field">N <input id="count" type="number" min="1" max="100" value="5" /></label>
          </div>
          <div class="row">
            <button id="add" class="primary">Add and run</button>
            <button id="undo">Undo</button>
            <button id="clear">Clear</button>
          </div>
          <p class="muted" id="status">Loading…</p>
        </section>
        <section>
          <h2>Replay</h2>
          <p class="muted">A run is its seed, its configuration and its action log. Save them, or open a
            saved run to replay it step by step.</p>
          <p class="replaying" id="replaying" hidden></p>
          <div class="row">
            <button id="copy-link">Copy the link</button>
            <button id="save-run">Save the run</button>
            <label class="inline file">Open a run <input id="open-run" type="file" accept="application/json,.json" /></label>
            <button id="edit-run" hidden>Edit this run</button>
          </div>
          <label class="wide">Or paste a run (JSON: config and actions)
            <textarea id="paste-run" rows="3" spellcheck="false"></textarea></label>
          <div class="row"><button id="replay-paste">Replay the pasted run</button></div>
        </section>
      </div>
      <section>
        <h2>Events up to now</h2>
        <label class="inline"><input id="show-msgs" type="checkbox" /> show every message sent</label>
        <div class="log" id="log"></div>
      </section>
    </div>
  </div>
  <script is:inline type="module" src={url("playground/app/main.js")}></script>
</Base>
