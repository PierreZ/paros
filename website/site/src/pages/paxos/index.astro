---
// The Paxos landing page (#949 (a map of the flavors)): one picture of a
// journal with each flavor at its place, a reading order with the problem
// each flavor solves, and the words that every flavor page links to.
import Doc from "../../layouts/Doc.astro";
import { REPO, url } from "../../nav";
import { LESSONS, TLC_RUN, pathOf } from "../../course";
import { CHAPTERS, played } from "../../tour";
import { FLAVORS } from "../../flavors";

const traces = import.meta.glob("../../traces/*.json", { eager: true, import: "default" }) as Record<string, { scenarios: { id: string; beats?: unknown[] }[] }>;
const traceOf = (page: string) => Object.entries(traces).find(([p]) => p.endsWith(`/${page}.json`))![1];
const PAGE_NAMES: Record<string, string> = {
  "single-decree": "Single-decree Paxos", "quorums": "Quorums", "multi-paxos": "Multi-Paxos",
  "compartmentalized": "Compartmentalized Paxos", "matchmaker": "Matchmaker Paxos",
  "journal-seal": "Journal segments",
};
const chapters = played(Object.fromEntries(Object.entries(traces).map(([p, t]) => [p.replace(/^.*\/(.+)\.json$/, "$1"), t])) as never, url);
const tourMinutes = chapters.reduce((s, c) => s + c.minutes, 0);
const lessons = LESSONS.map((l, i) => {
  const story = traceOf(l.page).scenarios.some((s) => s.beats?.length);
  return { ...l, n: i + 1, story, pageName: PAGE_NAMES[l.page] ?? l.page,
    href: url(pathOf(l)) + `#run=${l.runs[0]}&${story ? "beat" : "step"}=0` };
});


const WORDS = [
  { id: "acceptor", word: "Acceptor",
    text: "A party that votes. It writes its promise and its votes to disk before it answers." },
  { id: "leader", word: "Proposer, leader",
    text: "A proposer asks the acceptors to choose a value. A leader is a proposer that won Phase 1 and keeps its ballot for many slots." },
  { id: "ballot", word: "Ballot",
    text: "A number that puts the attempts to choose in order. It is a round and the node that made it, as round.node. A higher ballot wins over a lower one." },
  { id: "promise", word: "Promise",
    text: "The answer of an acceptor in Phase 1. The acceptor will not vote at a lower ballot again, and it tells the votes that it gave before." },
  { id: "quorum", word: "Quorum",
    text: "A set of acceptors whose answers are enough for a phase. Each Phase 1 quorum shares an acceptor with each Phase 2 quorum." },
  { id: "chosen", word: "Chosen",
    text: "A value is chosen when a Phase 2 quorum votes for it at one ballot. A chosen value never changes." },
  { id: "slot", word: "Slot",
    text: "One position in the log of a journal. Each slot is one single-decree Paxos." },
  { id: "configuration", word: "Configuration",
    text: "The acceptors and the quorum system that a ballot uses. A ballot keeps its configuration, and a new configuration needs a new ballot." },
];
const f = (n: number) => FLAVORS[n - 1];
---
<Doc title="The Paxos course" kicker="Paxos" section="paxos/" siblings={[]}
  description="A course in eight lessons, from one value to a journal that changes its acceptors. Every run on these pages is recorded from the real paros-consensus and paros-journal.">

  <h2 id="map">The map</h2>
  <p>One journal of a cell, from a write to the log. Each tag names the flavor that does the
  work at that place. Click a tag to open its page.</p>

  <div class="arch flavor-map" role="img" aria-label="A journal. Single-decree Paxos forms the cell and the matchmaker set. A client write goes to a batcher, then to the leader. The leader holds a ballot of Multi-Paxos and gives each write a slot. Proxy leaders send Phase 2 to the acceptors. The quorum system says which acceptors must answer. Matchmakers keep the configuration of each ballot. The chosen slots form the log, and replicas apply the log.">
    <div class="cellframe">
      <span class="cellname">one journal</span>
      <div class="row">
        <div class="box side">cell init · matchmaker set <small>the plan of the cell, chosen once</small>
          <a class="ftag" href={url(f(1).path)}>1 · {f(1).name}</a></div>
      </div>
      <div class="arrow">▼</div>
      <div class="box">client <small>Write · Read · Truncate · SetLeader</small></div>
      <div class="arrow">▼</div>
      <div class="box">batcher <small>joins writes into one slot</small>
        <a class="ftag" href={url(f(4).path)}>4 · Compartmentalized</a></div>
      <div class="arrow">▼</div>
      <div class="row">
        <div class="box lead">leader <small>holds the ballot, gives each write a slot</small>
          <a class="ftag" href={url(f(2).path)}>2 · {f(2).name}</a></div>
        <div class="box side">matchmakers <small>the configuration of each ballot</small>
          <a class="ftag" href={url(f(3).path)}>3 · Matchmaker</a></div>
      </div>
      <div class="arrow">▼</div>
      <div class="box">proxy leaders <small>send Phase 2, count the votes</small>
        <a class="ftag" href={url(f(4).path)}>4 · Compartmentalized</a></div>
      <div class="arrow">▼ <small>Accept → Accepted</small></div>
      <div class="box quorumbox">acceptors
        <span class="grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        <small>which ones must answer?</small>
        <a class="ftag" href={url(f(5).path)}>5 · {f(5).name}</a></div>
      <div class="arrow">▼ <small>chosen</small></div>
      <div class="box">log
        <span class="slots" aria-hidden="true"><i>1</i><i>2</i><i>3</i><i>4</i><i class="open">5</i><i class="open">…</i></span>
        <small>one slot is one single decree</small>
        <a class="ftag" href={url(f(2).path)}>2 · {f(2).name}</a></div>
      <div class="arrow">▼</div>
      <div class="box">replicas <small>apply the log, serve reads</small>
        <a class="ftag" href={url(f(4).path)}>4 · Compartmentalized</a></div>
    </div>
  </div>

  <h2 id="course">The course</h2>
  <p>Eight lessons, in order: seven on the Paxos flavors, then one on the journal that paros builds from them. Each lesson is a group of recorded runs on one page. A run tells
  one idea per screen, and before some screens it asks what will happen. At the end of a run,
  the page offers the next run of the lesson.</p>
  <a class="tour-entry" href={url("paxos/tour/")}>
    <span class="tour-entry-kicker label">Start here · {CHAPTERS.length} chapters · about {tourMinutes} min</span>
    <span class="tour-entry-title">▶ Watch the tour</span>
    <span class="tour-entry-text">One chapter for each of lessons 1 to 7. Press Play and watch the recorded runs, with no question. Each chapter ends with its lesson and its first exercise.</span>
  </a>
  <p class="course-resume" data-course-resume hidden></p>
  <ol class="course">
    {lessons.map((l) => (
      <li class="lesson" data-lesson={l.id} data-page={l.page} data-runs={l.runs.join(" ")}>
        <span class="lesson-n label tnum">{String(l.n).padStart(2, "0")}</span>
        <span class="lesson-body">
          <a class="lesson-title" href={l.href}>{l.title}</a>
          <span class="lesson-goal">After it, you can {l.goal}</span>
          <span class="lesson-tlc">
            <span class="tnum">{l.tlc.states.toLocaleString("en-US")}</span> states: TLC checked that {l.tlc.checks}{" "}
            (<a href={`${REPO}/blob/main/specs/tla/${l.tlc.model}/${l.tlc.config}.cfg`}><code>{l.tlc.model}/{l.tlc.config}</code></a>{l.tlc.date ? `, run on ${l.tlc.date}` : ""}).
          </span>
          <span class="lesson-meta label">
            <span>{l.pageName}</span>
            <span class="tnum">{l.runs.length} runs</span>
            {l.story
              ? <span class="lesson-progress tnum" data-progress />
              : <span class="chip-status">step-through only</span>}
            {l.labs?.length ? <span class="lesson-labs tnum" data-labs={l.labs.join(" ")}>{l.labs.length} {l.labs.length === 1 ? "exercise" : "exercises"}</span> : null}
          </span>
        </span>
      </li>
    ))}
  </ol>
  <p class="aside">Each lesson has a model in <a href={`${REPO}/tree/main/specs/tla`}><code>specs/tla/</code></a>,
  and the figure is the count of distinct states that {TLC_RUN.tool} found in one run of it on
  {TLC_RUN.date} (or on the day that the lesson names), with no error.</p>
  <p class="aside">Your progress stays in this browser only.
  <button type="button" class="linkish" data-course-forget hidden>Forget my progress</button></p>
  <p>Then the <a href={url("paxos/concepts/")}>concepts</a>: one short entry for each idea that
  paros uses, such as catch-up, the writer fence and boot safety.</p>

  <h2 id="order">The flavors</h2>
  <p>Each flavor solves the problem in its line.</p>
  <ol class="index-list flavor-order">
    {FLAVORS.map((x) => (
      <li><a href={url(x.path)}>{x.name}</a>
        <span class="desc"><b>Problem:</b> {x.problem} <b>Flavor:</b> {x.flavor}</span></li>
    ))}
  </ol>

  <h2 id="words">Words</h2>
  <p>Each flavor page links here the first time it uses one of these words.</p>
  <dl class="words">
    {WORDS.map((w) => (<><dt id={w.id}>{w.word}</dt><dd>{w.text}</dd></>))}
  </dl>
  <script is:inline src={url("course.js")}></script>
  <script is:inline set:html={`(function () {
    var c = window.paxosCourse;
    if (!c) return;
    var st = c.load();
    var any = false;
    document.querySelectorAll("[data-lesson]").forEach(function (li) {
      var page = li.dataset.page, runs = li.dataset.runs.split(" ");
      var seen = runs.filter(function (r) { return st.seen[page + "/" + r]; }).length;
      var out = li.querySelector("[data-progress]");
      if (!out) return;
      if (seen) any = true;
      out.textContent = seen === runs.length ? "done" : seen ? seen + " of " + runs.length + " seen" : "";
      out.className = "lesson-progress tnum" + (seen === runs.length ? " chip-status done" : "");
      li.classList.toggle("is-done", seen === runs.length);
      var labs = li.querySelector("[data-labs]");
      if (labs) {
        var ids = labs.dataset.labs.split(" ");
        var solved = ids.filter(function (id) { return st.solved[id]; }).length;
        if (solved) { any = true; labs.textContent = solved + " of " + ids.length + (ids.length === 1 ? " exercise" : " exercises") + " solved"; }
      }
    });
    var last = st.last;
    if (last) {
      var p = document.querySelector("[data-course-resume]");
      var a = document.createElement("a");
      a.href = ${JSON.stringify(url("paxos/"))} + last.page + "/#run=" + encodeURIComponent(last.run) + "&beat=" + (last.beat | 0);
      a.className = "btn primary";
      a.textContent = "Continue where you stopped";
      p.appendChild(a);
      p.hidden = false;
    }
    var f = document.querySelector("[data-course-forget]");
    if (any || last) {
      f.hidden = false;
      f.addEventListener("click", function () { c.forget(); location.reload(); });
    }
  })();`} />
</Doc>
