<Doc title="paros-consensus" kicker="Consensus" section="consensus/" siblings={[]}
  description="Every Paxos role as a sans-IO state machine, in one Rust library. Plain Multi-Paxos, single decree, and every flavor of the Paxos pages.">

  <div class="strip" aria-label="paros-consensus in figures">
    <div><span class="k">I/O, clock, randomness</span><span class="v">none</span></div>
    <div><span class="k">Deployments</span><span class="v">4</span></div>
