    mutants: ["batcher: ReverseLane"],
    state: "checked",
  },
  {
    claim: "Each claim above holds at every size, not only on the bounded instances that TLC explores.",
    models: [{ dir: "decree", inv: ["Inv"] }, { dir: "multi-paxos", inv: ["Inv"] }],
    trace: [],
    walk: "",
    controls: ["inductive_ignore", "inductive_prefix"],
    mutants: [],
    state: "open",
    issue: { n: 1307, name: "inductive invariants, then proofs" },
    note: "Decree: TLAPS proves that Inv holds at the start, that every step keeps it and that it implies Agreement (DecreeProof.tla); the temporal rule that joins them is not checked (no LS4 in the TLAPS of nixpkgs). Multi-Paxos: TLC checks drawn states only; no proof yet.",
  },
];

