    claim: "One term of an election over a journal has one holder: the holder writes only in its own term, and stops at its first refused write. The interface that the journal publishes is the one of the term's holder.",
    models: [{ dir: "election", inv: ["TermTrue", "WriteInTerm", "NoRegress", "StopsAtRefusal", "IfaceOfTerm", "PubTrue", "ModeKept"] }],
    trace: [],
    walk: "",
    controls: ["no_fence", "late_challenge", "no_stop", "reinstate", "iface_kept", "multi", "any_answer"],
    mutants: [],
    state: "model",
    issue: { n: 1420, name: "paros-election" },
  },
  {
    claim: "One id names at most one journal, forever: a fold gives an id once, deletes included, and a host keeps records under an id only after the fold gave it. Every create ends.",
    models: [{ dir: "journal-ids", inv: ["JournalIdOnce", "TenantIdOnce", "DiskOneJournal", "BookedAfterRecord", "GoneStays", "AllCreated"] }],
    trace: [],
    walk: "",
    controls: ["book_first", "no_tombs", "no_tombs_disk", "journal_key", "counter"],
    mutants: [],
