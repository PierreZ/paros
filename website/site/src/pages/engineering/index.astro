    trace: [],
    walk: "",
    controls: ["book_first", "no_dedup", "partial", "no_limit", "no_free", "fixed", "no_abandon"],
    mutants: [],
    state: "model",
    issue: { n: 1421, name: "the placement port" },
  },
  {
    claim: "An order of a deposed coordinator never takes effect, and a machine hosts each role once, only where its booking says. Once the faults stop, every coordinator stops sending and every role settles.",
    models: [{ dir: "takeover", inv: ["NoLateEffect", "OnceEach", "EffectBooked", "Complete", "Settles", "Quiet"] }],
    trace: [],
    walk: "",
    controls: ["two_writes", "two_writes_late", "no_idem", "keep_view", "fallback", "reg_nofence", "ref_in_booking", "nack_ignored", "gone_ignored"],
    mutants: [],
    state: "model",
    issue: { n: 1422, name: "the takeover by a new controller" },
