---
// The safety case (#1361 (a safety case for consensus and journal)): one row
// per safety claim of paros-consensus and of the journal, with the TLA+ model,
// the trace spec, the walk and the mutants behind it. The open rows stay: the
// page says what is not proved. Every name below exists in the repository.
import Doc from "../../layouts/Doc.astro";
import { REPO, url } from "../../nav";
const TLA = `${REPO}/tree/main/specs/tla`;
const BLOB = `${REPO}/blob/main/specs/tla`;
const ISSUE = (n: number) => `${REPO}/issues/${n}`;

/** A link to a model folder, a trace spec, or a crate path. */
interface Ref { text: string; href?: string }
type State = "checked" | "model" | "open";
interface Claim {
  claim: string;
  /** The model folders, each with the invariants that state the claim. */
  models: { dir: string; inv: string[] }[];
  trace: string[];
  walk: string;
  /** TLC controls (a check that must fail) and walk mutants (a planted bug). */
  controls: string[];
  mutants: string[];
  state: State;
  /** The issue that keeps the row open, or the step that builds its code. */
  issue?: { n: number; name: string };
  note?: string;
}

const CONSENSUS: Claim[] = [
  {
    claim: "One value is chosen per slot.",
    models: [{ dir: "decree", inv: ["Agreement", "Inv"] }, { dir: "multi-paxos", inv: ["Agreement", "Inv"] }, { dir: "node", inv: ["Agreement"] }],
    trace: ["decree/DecreeTrace.tla", "node/MultiPaxosTrace.tla"],
    walk: "decree walk, multi_paxos, multi_paxos_five, grid, partitions · ONE_VALUE",
    controls: ["inductive_ignore", "wipe_revote", "lost"],
    mutants: ["ForgetVotes", "HideVotes", "decree: ForgetPromise, HideVote"],
    state: "checked",
  },
  {
    claim: "A promise or a vote leaves a node only once it is on the node's disk.",
    models: [{ dir: "multi-paxos", inv: ["Agreement"] }],
    trace: ["node/MultiPaxosTrace.tla"],
