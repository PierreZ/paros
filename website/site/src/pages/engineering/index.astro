    trace: [],
    walk: "",
    controls: ["nofirst", "trim_open", "cache_unchecked"],
    mutants: [],
    state: "open",
    issue: { n: 1321, name: "make crash_all and live_all finish" },
    note: "Two checks of the model do not finish.",
  },
