    claim: "The health measures give one journal state, and v1 acts on it.",
    models: [{ dir: "health", inv: [] }],
    trace: [],
    walk: "",
    controls: ["p2_only", "draft_states"],
    mutants: [],
    state: "open",
    issue: { n: 1319, name: "a v1 switch in health/" },
  },
