    trace: ["proxy-leader/ProxyLeaderTrace.tla"],
    walk: "proxies, proxies_on_grid, compartments · COMMIT_BACKED",
    controls: ["short", "belief_any"],
    mutants: ["EarlyCommit", "KeepProxyRounds"],
    state: "checked",
  },
  {
    claim: "What a party learns or applies is the value that was chosen.",
    models: [{ dir: "multi-paxos", inv: ["LearnedChosen"] }, { dir: "node", inv: ["LearnedChosen", "ReplicaChosen"] }],
    trace: ["node/MultiPaxosTrace.tla", "node/CompartmentsTrace.tla"],
    walk: "replicas, compartments_compacting · LEARNED_CHOSEN",
