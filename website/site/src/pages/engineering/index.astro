    mutants: ["CorruptCommit"],
    state: "checked",
  },
  {
    claim: "The chosen prefix on a disk never moves back while its node runs, and keeps what an fsync covered.",
    models: [],
    trace: [],
    walk: "every flavor · PREFIX_SHRINKS",
    controls: [],
    mutants: ["LoseChosenIndex"],
    state: "checked",
    note: "Judged by the walk oracle only; no model states it.",
  },
  {
    claim: "A leaderless read sees every write that was acknowledged before it started.",
