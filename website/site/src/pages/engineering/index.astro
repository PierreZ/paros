    walk: "fold walk · FOLD, VIEW",
    controls: ["gap_off", "lookup_local"],
    mutants: ["LostLog", "StaleBoundary"],
    state: "checked",
    issue: { n: 1326, name: "journal roles" },
    note: "Checked on the fold of paros-journal. The roles that carry a write are not built yet.",
  },
  {
    claim: "A single writer gets exactly-once writes; a fenced write is judged under its uuid.",
    models: [{ dir: "multi-writer", inv: ["ExactlyOnce", "FenceTrue", "RefusalFinal"] }],
    trace: ["journal-state/FoldTrace.tla"],
    walk: "fold walk · FOLD",
    controls: ["dedup_after", "fence_propose", "basis_stale"],
    mutants: ["LostLog"],
    state: "checked",
    issue: { n: 1326, name: "journal roles" },
    note: "The fold walk switches to multi-writer and back; the roles are not built yet.",
  },
  {
    claim: "A Resolve answers the fate that the whole log gives the write.",
    models: [{ dir: "journal-state", inv: ["ResolveTrue"] }],
    trace: ["journal-state/FoldTrace.tla"],
    walk: "fold walk · RESOLVE",
    controls: ["resolve_uuid", "resolve_early"],
    mutants: ["ResolveInForce"],
    state: "checked",
  },
  {
    claim: "A replica that restarts folds its segment again to the same state.",
    models: [{ dir: "journal-state", inv: ["OneFold"] }],
    trace: ["journal-state/FoldTrace.tla"],
    walk: "fold walk · REFOLD",
    controls: [],
    mutants: ["RefoldShort"],
    state: "checked",
  },
  {
    claim: "A done register write is never lost across a matchmaker set handover, and a step acts only on a value that every serving majority holds.",
    models: [{ dir: "segment-records", inv: ["Carried", "SealOnce", "RetireKept", "DropKept"] }, { dir: "cas-register", inv: [] }],
    trace: ["segment-records/RegisterTrace.tla"],
    walk: "register walk · CARRIED, ACTED",
    controls: ["close_one", "drop_read"],
    mutants: ["SendBeforePersist", "ActOnRead"],
    state: "checked",
  },
  {
    claim: "A seal ends where the boundary state says: a sealed grid chooses nothing at or above its end, and next_seq never moves back.",
    models: [{ dir: "journal-state", inv: ["SealedFrozen", "RecordTrue", "NoMoveBack"] }, { dir: "seal-chain", inv: ["RecordTrue"] }, { dir: "seal-ctrl", inv: [] }],
    trace: [],
    walk: "",
    controls: ["end_read", "end_applied", "record_latest"],
    mutants: [],
    state: "model",
    issue: { n: 1326, name: "journal roles" },
  },
  {
    claim: "An acceptor sends a promise or a vote only once it is durable, and writes a raised promise before or with the vote.",
    models: [{ dir: "journal-state", inv: ["Agreement"] }, { dir: "flight-rule", inv: ["SentIsDurable"] }],
    trace: [],
    walk: "",
    controls: ["reply_mem1b", "reply_mem2b", "order_vote_first", "send_early"],
    mutants: [],
    state: "model",
    issue: { n: 1326, name: "journal roles" },
  },
