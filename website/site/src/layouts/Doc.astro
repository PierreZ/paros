---
// A reading page: the title block, the text, and the pages of its section.
import Base from "./Base.astro";
import { url } from "../nav";
import { LESSONS, check, lessonsOf } from "../course";

interface Sibling { title: string; path: string }
interface Props {
  frontmatter?: { title: string; description?: string; kicker?: string; section?: string; siblings?: string; trace?: string; widget?: string; lab?: string };
  /** A live widget of public/engineering.js on this page (#812). */
  widget?: boolean;
  title?: string;
  description?: string;
  kicker?: string;
  section?: string;
  siblings?: Sibling[];
}
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title;
const description = Astro.props.description ?? fm.description;
const kicker = Astro.props.kicker ?? fm.kicker ?? "";
const section = Astro.props.section ?? fm.section ?? "";
const PAGES: Record<string, Sibling[]> = {
  "paxos/": [
    { title: "Single-decree Paxos", path: "paxos/single-decree/" },
    { title: "Multi-Paxos", path: "paxos/multi-paxos/" },
    { title: "Matchmaker Paxos", path: "paxos/matchmaker/" },
    { title: "Compartmentalized Paxos", path: "paxos/compartmentalized/" },
    { title: "Quorums", path: "paxos/quorums/" },
    { title: "Concepts", path: "paxos/concepts/" },
  ],
  "engineering/": [
    { title: "The sans-IO core", path: "engineering/sans-io/" },
    { title: "Grid quorums", path: "engineering/grid-quorums/" },
  ],
};
// A Paxos page names its step-through trace (#811): src/traces/<name>.json,
// recorded from paros-consensus by `cargo test -p paros-wasm --test paxos_traces`.
const traces = import.meta.glob("../traces/*.json", { eager: true, import: "default" });
const trace = fm.trace ? traces[`../traces/${fm.trace}.json`] : undefined;
if (fm.trace && !trace) throw new Error(`no trace src/traces/${fm.trace}.json`);
type T = { scenarios: { id: string; label: string; beats?: unknown[] }[] };
const byPage = Object.fromEntries(Object.entries(traces).map(([p, t]) => [p.replace(/^.*\/(.+)\.json$/, "$1"), t as T]));
check(byPage);
// The lessons of this page, for public/story.js: each run with its label,
// and where the reader goes when the lesson ends.
const course = fm.trace ? lessonsOf(fm.trace).map((l) => {
  const next = LESSONS[l.n];
  const story = (p: string) => byPage[p].scenarios.some((s) => s.beats?.length);
  return {
    n: l.n, id: l.id, title: l.title, of: LESSONS.length, labs: l.labs ?? [],
    runs: l.runs.map((id) => ({ id, label: byPage[l.page].scenarios.find((s) => s.id === id)!.label })),
    next: next && { n: l.n + 1, title: next.title, page: next.page,
      href: url(`paxos/${next.page}/`) + `#run=${next.runs[0]}&${story(next.page) ? "beat" : "step"}=0` },
  };
}) : [];
const widget = Astro.props.widget ?? Boolean(fm.widget);
const siblings = Astro.props.siblings ?? PAGES[section] ?? [];
const here = Astro.url.pathname;
const i = siblings.findIndex((s) => here.endsWith("/" + s.path));
const prev = i > 0 ? siblings[i - 1] : undefined;
const next = i >= 0 && i < siblings.length - 1 ? siblings[i + 1] : undefined;
---
<Base title={title} description={description} section={section}>
  <div class="page">
    <div class="titleblock">
      {kicker && <div class="kicker label">{kicker}</div>}
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
    </div>
    <article class="prose">
      <slot />
    </article>
    {trace && <script is:inline type="application/json" id="trace" data-wasm={url("paxos/wasm/paros_paxos.js")} set:html={JSON.stringify(trace).replace(/</g, "\\u003c")} />}
    {trace && <script is:inline type="application/json" id="course" set:html={JSON.stringify({ lessons: course, map: url("paxos/#course") }).replace(/</g, "\\u003c")} />}
    {trace && <script is:inline src={url("course.js")} />}
    {trace && <script is:inline src={url("story.js")} />}
    {trace && <script is:inline src={url("steps.js")} />}
    {widget && <script is:inline type="module" src={url("engineering.js")} />}
    {fm.lab && <script is:inline type="module" src={url("lab.js")} />}
    {(prev || next) && (
      <nav class="pager label" aria-label="Next and previous pages">
        {prev ? <a href={url(prev.path)}>← {prev.title}</a> : <span />}
        {next ? <a href={url(next.path)}>{next.title} →</a> : <span />}
      </nav>
    )}
  </div>
</Base>
