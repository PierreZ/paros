---
// A reading page: the title block, the text, and the pages of its section.
import Base from "./Base.astro";
import { REPO, url } from "../nav";
import { LESSONS, check, lessonsOf, pathOf } from "../course";
import { CHAPTERS, check as checkTour, played } from "../tour";

interface Sibling { title: string; path: string }
interface Props {
  frontmatter?: { title: string; description?: string; kicker?: string; section?: string; siblings?: string; trace?: string; widget?: string; lab?: string; status?: string };
  /** A live widget of public/engineering.js on this page (#812). */
  widget?: boolean;
  title?: string;
  description?: string;
  kicker?: string;
  section?: string;
  siblings?: Sibling[];
  /** A status callout under the title (`STATUS` below). */
  status?: string;
}
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title;
const description = Astro.props.description ?? fm.description;
const kicker = Astro.props.kicker ?? fm.kicker ?? "";
const section = Astro.props.section ?? fm.section ?? "";
const PAGES: Record<string, Sibling[]> = {
  "paxos/": [
    { title: "Single-decree Paxos", path: "paxos/single-decree/" },
    { title: "Multi-Paxos", path: "paxos/multi-paxos/" },
    { title: "Matchmaker Paxos", path: "paxos/matchmaker/" },
    { title: "Compartmentalized Paxos", path: "paxos/compartmentalized/" },
    { title: "Quorums", path: "paxos/quorums/" },
    { title: "Concepts", path: "paxos/concepts/" },
  ],
  "consensus/": [
    { title: "paros-consensus", path: "consensus/" },
    { title: "The driver loop", path: "consensus/driver/" },
    { title: "The deployments", path: "consensus/deployments/" },
    { title: "How it is checked", path: "consensus/proof/" },
  ],
  "parosd/": [
    { title: "parosd", path: "parosd/" },
    { title: "Layers that stand alone", path: "parosd/layers/" },
    { title: "One shape at every level", path: "parosd/control/" },
    { title: "Machines", path: "parosd/machines/" },
    { title: "Names and tokens", path: "parosd/names-and-tokens/" },
    { title: "The universe", path: "parosd/universe/" },
  ],
  "engineering/": [
    { title: "The safety case", path: "engineering/" },
    { title: "TLA+ models", path: "engineering/tla/" },
    { title: "Simulation", path: "engineering/simulation/" },
    { title: "Mutants and assertions", path: "engineering/mutants/" },
    { title: "Grid quorums", path: "engineering/grid-quorums/" },
  ],
};
// A Paxos page names its step-through trace (#811): src/traces/<name>.json,
// recorded from paros-consensus by `cargo test -p paros-wasm --test paxos_traces`.
const traces = import.meta.glob("../traces/*.json", { eager: true, import: "default" });
const trace = fm.trace ? traces[`../traces/${fm.trace}.json`] : undefined;
// The exercises of the Paxos course (public/lab.js), not the Journal labs.
const paxosLab = !!fm.lab;
if (fm.trace && !trace) throw new Error(`no trace src/traces/${fm.trace}.json`);
type T = { scenarios: { id: string; label: string; beats?: unknown[] }[] };
const byPage = Object.fromEntries(Object.entries(traces).map(([p, t]) => [p.replace(/^.*\/(.+)\.json$/, "$1"), t as T]));
check(byPage);
checkTour(byPage as never);
// The chapters of the tour on this page (public/tour.js): "Watch this flavor".
const chapters = fm.trace ? played(byPage as never, url, fm.trace) : [];
const tourData = { chapters, of: CHAPTERS.length, all_href: url("paxos/tour/") };
// The lessons of this page, for public/story.js: each run with its label,
// and where the reader goes when the lesson ends.
const course = fm.trace ? lessonsOf(fm.trace).map((l) => {
  const next = LESSONS[l.n];
  const story = (p: string) => byPage[p].scenarios.some((s) => s.beats?.length);
  return {
    n: l.n, id: l.id, title: l.title, of: LESSONS.length, labs: l.labs ?? [],
    runs: l.runs.map((id) => ({ id, label: byPage[l.page].scenarios.find((s) => s.id === id)!.label })),
    next: next && { n: l.n + 1, title: next.title, page: next.page,
      href: url(pathOf(next)) + `#run=${next.runs[0]}&${story(next.page) ? "beat" : "step"}=0` },
  };
}) : [];
// The engine that records the trace again in the browser: paros-consensus
// (`paxos_trace`).
const engine = { wasm: url("paxos/wasm/paros_paxos.js"), call: "paxos_trace", source: "paros-consensus" };
// A page of a design that is checked but not built yet says so at the top (#1349).
const STATUS: Record<string, { tag: string; html: string }> = {
  parosd: {
    tag: "design · not built",
    html: `The design of parosd is written in
      <a href="${REPO}/tree/main/docs/architecture"><code>docs/architecture/</code></a>, and its
      code is not built. The layers are built after the journal, in the order of
      <a href="${REPO}/issues/1409">#1409</a>. This page explains the design and links each
      section; the rules are in the docs.`,
  },
};
const statusName = Astro.props.status ?? fm.status;
const status = statusName ? STATUS[statusName] : undefined;
if (statusName && !status) throw new Error(`no status "${statusName}" in Doc.astro`);
const widget = Astro.props.widget ?? Boolean(fm.widget);
const siblings = Astro.props.siblings ?? PAGES[section] ?? [];
const here = Astro.url.pathname;
const i = siblings.findIndex((s) => here.endsWith("/" + s.path));
const prev = i > 0 ? siblings[i - 1] : undefined;
const next = i >= 0 && i < siblings.length - 1 ? siblings[i + 1] : undefined;
---
<Base title={title} description={description} section={section}>
  <div class="page">
    <div class="titleblock">
      {kicker && <div class="kicker label">{kicker}</div>}
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
    </div>
    <article class="prose">
      {status && <div class="callout status" data-tag={status.tag}><p set:html={status.html} /></div>}
      <slot />
    </article>
    {trace && <script is:inline type="application/json" id="trace" data-wasm={engine.wasm} data-call={engine.call} data-source={engine.source} set:html={JSON.stringify(trace).replace(/</g, "\\u003c")} />}
    {trace && <script is:inline type="application/json" id="course" set:html={JSON.stringify({ lessons: course, map: url("paxos/#course") }).replace(/</g, "\\u003c")} />}
    {trace && <script is:inline src={url("course.js")} />}
    {(trace || paxosLab) && <script is:inline src={url("stage.js")} />}
    {trace && <script is:inline src={url("story.js")} />}
    {trace && <script is:inline src={url("steps.js")} />}
    {chapters.length > 0 && <script is:inline type="application/json" id="tour" set:html={JSON.stringify(tourData).replace(/</g, "\\u003c")} />}
    {chapters.length > 0 && <script is:inline src={url("tour.js")} />}
    {widget && <script is:inline type="module" src={url("engineering.js")} />}
    {paxosLab && <script is:inline type="module" src={url("lab.js")} />}
    {(prev || next) && (
      <nav class="pager label" aria-label="Next and previous pages">
        {prev ? <a href={url(prev.path)}>← {prev.title}</a> : <span />}
        {next ? <a href={url(next.path)}>{next.title} →</a> : <span />}
      </nav>
    )}
  </div>
</Base>
