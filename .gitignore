# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# Added by cargo

/target

# Nix / direnv
.direnv/

# The site's build output and the theme copied in at build time (website/zola/build.sh)
/website/zola/public/
/website/zola/themes/

# Claude Code local settings
.claude/settings.local.json

# Claude Code agent worktrees (nested checkouts, never project content)
.claude/worktrees/

# cargo-mutants output (`scripts/mutants.sh`)
mutants.out/
mutants.out.old/
mutants.first/
survivors.txt
# The negative hunt's output (`cargo xtask negative`, #742)
negative.out/
/target-main

# ub-mode tool output (crapper, dryer, mutator)
.metrics/

# TLC writes its state files here when it runs without -metadir.
specs/tla/*/states/

# Python bytecode (scripts/mutate-tla.py)
__pycache__/

# TLAPS writes its fingerprint cache beside each proof (scripts/check-proofs.sh).
specs/tla/**/*.tlaps/
