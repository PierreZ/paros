# A store drops its last durable entry at its second boot (#912 (excuses
# too wide)). Before #912 the audit excused every record a node missed at
# every later boot once it had one corruption crash, so on such a node this
# lost vote hid behind the excuse. Now a corruption crash explains only the
# next boot's missing records. The narrowed excuse (`loss: corruption
# crash`) fired on no seed of 600, so the mutant drops the entry on every
# store and must be red anywhere.
excuse: none
file: crates/lib/paros-storage/src/journal/node.rs
--- find
        // Everything below the floor is chosen (pair of the live trim-point
        // jump), whatever chosen index the metainfo last carried.
--- replace
        {
            let mut boots = MUTANT_BOOTS.lock().unwrap();
            let boots = boots
                .entry((self.config.id.0, self.dir.clone()))
                .or_insert(0);
            *boots += 1;
            if *boots == 2 {
                self.accepted.pop_last();
            }
        }
        // Everything below the floor is chosen (pair of the live trim-point
        // jump), whatever chosen index the metainfo last carried.
--- end
--- find
use std::collections::{BTreeMap, BTreeSet};
--- replace
use std::collections::{BTreeMap, BTreeSet};

static MUTANT_BOOTS: std::sync::Mutex<BTreeMap<(u64, String), u32>> =
    std::sync::Mutex::new(BTreeMap::new());
--- end
